{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garmin Bridge",
  "version": "0.3.0",
  "identifier": "com.anneo22.garminbridge",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "../scripts/fetch-runtime.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Garmin Bridge",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../../engine": "engine",
      "../../bin": "bin",
      "../../vendor/python": "python",
      "../../vendor/site-packages": "site-packages",
      "../../vendor/gphoto2": "gphoto2"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
